---
import { profile } from '../data/profile';
import type { Lang } from '../data/translations';
const { lang } = Astro.props as { lang: Lang };
const es = lang === 'es';
---
<section id="proyectos" class="py-20 lg:py-28 bg-[var(--primary)] text-[var(--primary-foreground)]" aria-labelledby="projects-heading">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <h2 id="projects-heading" class="font-display text-5xl xl:text-6xl mb-8">{es ? 'PROYECTOS Y' : 'PROJECTS &'} <span class="text-[var(--accent)]">{es ? 'CÓDIGO' : 'CODE'}</span></h2>
    <div class="grid lg:grid-cols-[1.2fr_1fr] border-2 border-white/30">
      <div class="p-8 lg:p-10">
        <p class="font-sans text-lg leading-relaxed max-w-xl mb-6">{es ? 'Desarrollo módulos, interfaces e integraciones para resolver procesos de negocio con Odoo.' : 'I develop modules, interfaces and integrations to support business processes with Odoo.'}</p>
        <p class="font-sans text-sm leading-relaxed opacity-80 max-w-xl">{es ? 'Puedes explorar mi código público en GitHub. Aquí iré documentando los proyectos que pueda compartir, con su contexto, solución técnica y estado de validación.' : 'Explore my public code on GitHub. I will document shareable projects here, including their context, technical solution and validation status.'}</p>
      </div>
      <div class="bg-[var(--background)] text-[var(--foreground)] p-8 lg:p-10 flex flex-col justify-center items-start gap-5">
        <span class="font-mono text-sm">github.com/deyvidsdev</span>
        <h3 class="font-display text-3xl">{es ? 'EXPLORA MIS REPOSITORIOS' : 'EXPLORE MY REPOSITORIES'}</h3>
        <a href={profile.github + '?tab=repositories'} target="_blank" rel="noopener noreferrer" class="inline-flex px-6 py-3 border-2 border-[var(--border)] font-display text-xl hover:bg-[var(--accent)] hover:text-white transition-colors">{es ? 'VER EN GITHUB ↗' : 'VIEW ON GITHUB ↗'}</a>
      </div>
    </div>
  </div>
</section>
